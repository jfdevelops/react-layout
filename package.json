{
  "name": "view-map-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./packages/core dev",
    "dev:basic-example": "pnpm --filter basic-example dev",
    "build": "pnpm -r --filter \"@jfdevelops/*\" build",
    "build:examples": "pnpm --filter basic-example build",
    "typecheck": "pnpm -r --filter \"@jfdevelops/*\" typecheck",
    "typecheck:examples": "pnpm --filter basic-example typecheck",
    "test": "pnpm -r --filter \"@jfdevelops/*\" test",
    "test:watch": "pnpm -r --filter \"@jfdevelops/*\" test:watch",
    "test:ui": "pnpm --filter ./packages/core test:ui",
    "test:coverage": "pnpm --filter ./packages/core test:coverage",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "preview": "pnpm --filter ./packages/core preview",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt . && oxlint --fix --deny-warnings && oxfmt .",
    "format:check": "oxfmt --check .",
    "check:declarations": "node scripts/check-declaration-docs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@jfdevelops/cli": "0.8.0",
    "@jfdevelops/skills": "0.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "portless": "^0.15.9",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.28.1"
}
