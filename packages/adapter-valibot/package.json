{
  "name": "@jfdevelops/react-layout-adapter-valibot",
  "version": "0.1.1",
  "description": "Native valibot schemas for React nodes and elements in React Layout.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfdevelops/react-layout.git",
    "directory": "packages/adapter-valibot"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jfdevelops/react-layout-adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsdown": "0.22.1",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "valibot": "^1.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
