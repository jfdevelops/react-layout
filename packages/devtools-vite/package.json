{
  "name": "@jfdevelops/react-layout-devtools-vite",
  "version": "1.0.0",
  "description": "Opt-in Vite development source locations and render-state previews for react-layout.",
  "keywords": [
    "devtools",
    "react",
    "react-layout",
    "vite-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jfdevelops/react-layout.git",
    "directory": "packages/devtools-vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "pnpm -w exec tsc --noEmit -p packages/devtools-vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "magic-string": "0.30.21",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsdown": "0.22.1",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
