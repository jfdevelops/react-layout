{
  "name": "@jfdevelops/react-layout-adapter-zod",
  "version": "0.1.1",
  "description": "Native zod schemas for React nodes and elements in React Layout.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfdevelops/react-layout.git",
    "directory": "packages/adapter-zod"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../adapters/vite.config.ts"
  },
  "dependencies": {
    "@jfdevelops/react-layout-adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsdown": "0.22.1",
    "vitest": "4.1.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
