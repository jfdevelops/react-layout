{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "jsx-a11y",
    "import",
    "vitest",
    "oxc"
  ],
  "jsPlugins": ["@stylistic/eslint-plugin", "./tools/oxlint-plugin.mjs"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@stylistic/object-curly-newline": [
      "error",
      {
        "ObjectExpression": {
          "minProperties": 1
        }
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      }
    ],
    "eslint/curly": ["error", "all"],
    "workspace/object-property-newline": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts"
  ],
  "overrides": [
    {
      "files": [
        "packages/composables/tests/defined-composable-overloads.test-d.tsx",
        "packages/core/tests/create-config/bound-make-composable.test.tsx",
